@@ -0,0 +1,87 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import com.duszek.pindrop.entity.DayPinRole;
+import com.duszek.pindrop.entity.DayRole;
+import org.junit.jupiter.api.Test;
+
+import java.time.LocalDate;
+import java.time.LocalTime;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class DayPlanConcretenessValidatorTest {
+
+	@Test
+	void rejectsDestinationNamedPinsAndMissingNarrative() {
+		GeneratedDayPlan plan = new GeneratedDayPlan(
+				1,
+				LocalDate.parse("2026-08-04"),
+				"Lake day",
+				null,
+				List.of("Lake"),
+				DayRole.EXPLORE,
+				"CITY_WALKING",
+				new GeneratedDayPlan.Stats(7.0, "6 h", null, 40, 60, "EUR"),
+				List.of(block("Meal in Lake Geneva", DayBlockKind.FOOD, List.of(
+						pin("Lake Geneva", DayPinRole.STOP, 46.2, 6.1)))));
+
+		List<String> errors = DayPlanConcretenessValidator.validate(plan, "Lake Geneva, Switzerland");
+		assertTrue(errors.stream().anyMatch(error -> error.toLowerCase().contains("narrative")));
+		assertTrue(errors.stream().anyMatch(error -> error.toLowerCase().contains("destination")));
+	}
+
+	@Test
+	void rejectsSharedCoordinates() {
+		GeneratedDayPlan plan = validPlan(List.of(
+				pin("Harbor square", DayPinRole.STOP, 46.2, 6.1),
+				pin("Arcade street", DayPinRole.STOP, 46.2, 6.1)));
+
+		List<String> errors = DayPlanConcretenessValidator.validate(plan, "Lake Geneva, Switzerland");
+		assertTrue(errors.stream().anyMatch(error -> error.toLowerCase().contains("same coordinates")));
+	}
+
+	@Test
+	void acceptsUniqueConcretePins() {
+		GeneratedDayPlan plan = validPlan(List.of(
+				pin("Wodogrzmoty Mickiewicza", DayPinRole.TRAILHEAD, 49.213, 20.071),
+				pin("Czarny Staw", DayPinRole.VIEWPOINT, 49.188, 20.076),
+				pin("Schronisko przy Morskim Oku", DayPinRole.HUT, 49.201, 20.071)));
+
+		assertTrue(DayPlanConcretenessValidator.validate(plan, "Zakopane, Poland").isEmpty());
+	}
+
+	@Test
+	void looksGenericCatchesHydratorTitles() {
+		assertTrue(DayPlanConcretenessValidator.looksGeneric("Meal in Lake Geneva", "Lake Geneva, Switzerland"));
+		assertTrue(DayPlanConcretenessValidator.looksGeneric("Check in and orient", "Lisbon, Portugal"));
+		assertFalse(DayPlanConcretenessValidator.looksGeneric("A Baiuca", "Lisbon, Portugal"));
+	}
+
+	private static GeneratedDayPlan validPlan(List<GeneratedDayPlan.GeneratedDayPin> pins) {
+		return new GeneratedDayPlan(
+				1,
+				LocalDate.parse("2026-08-04"),
+				"Ridge day",
+				"Start before 8:00 from a named trailhead.",
+				List.of("Ridge", "Hut lunch"),
+				DayRole.EXCURSION,
+				"MOUNTAIN_TRAIL",
+				new GeneratedDayPlan.Stats(14.0, "8 h", 1100, 25, 40, "EUR"),
+				List.of(block("Ridge traverse", DayBlockKind.TREK, pins)));
+	}
+
+	private static GeneratedDayPlan.GeneratedDayBlock block(
+			String title, DayBlockKind kind, List<GeneratedDayPlan.GeneratedDayPin> pins) {
+		return new GeneratedDayPlan.GeneratedDayBlock(
+				kind, LocalTime.of(8, 30), LocalTime.of(17, 0), null, title,
+				"Main chapter of the day.", null, null, null, null, null, null, null,
+				List.of(), pins, List.of());
+	}
+
+	private static GeneratedDayPlan.GeneratedDayPin pin(String name, DayPinRole role, double lat, double lng) {
+		return new GeneratedDayPlan.GeneratedDayPin(name, role, lat, lng, null, null, null, null);
+	}
+}
