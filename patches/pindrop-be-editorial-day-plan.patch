diff --git a/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlanConcretenessValidator.java b/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlanConcretenessValidator.java
new file mode 100644
index 0000000..5a5700f
--- /dev/null
+++ b/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlanConcretenessValidator.java
@@ -0,0 +1,129 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import com.duszek.pindrop.entity.DayPinRole;
+
+import java.util.ArrayList;
+import java.util.EnumSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+public final class DayPlanConcretenessValidator {
+
+	private static final Set<DayBlockKind> CORE_KINDS = EnumSet.of(
+			DayBlockKind.TREK,
+			DayBlockKind.CITY_WALK,
+			DayBlockKind.MUSEUM,
+			DayBlockKind.BEACH,
+			DayBlockKind.CAMP,
+			DayBlockKind.FOOD);
+
+	private DayPlanConcretenessValidator() {
+	}
+
+	public static List<String> validate(GeneratedDayPlan plan, String destination) {
+		List<String> errors = new ArrayList<>();
+		if (plan == null) {
+			errors.add("Day plan is missing");
+			return errors;
+		}
+		if (plan.narrative() == null || plan.narrative().isBlank()) {
+			errors.add("Day narrative is required");
+		}
+		if (plan.blocks() == null || plan.blocks().isEmpty()) {
+			errors.add("Day must contain at least one time block");
+			return errors;
+		}
+
+		List<GeneratedDayPlan.GeneratedDayPin> allPins = new ArrayList<>();
+		boolean hasCorePin = false;
+		for (GeneratedDayPlan.GeneratedDayBlock block : plan.blocks()) {
+			if (block.narrative() == null || block.narrative().isBlank()) {
+				errors.add("Block '" + block.title() + "' is missing narrative");
+			}
+			if (block.title() != null && looksGeneric(block.title(), destination)) {
+				errors.add("Block title is generic: " + block.title());
+			}
+			List<GeneratedDayPlan.GeneratedDayPin> pins = block.pins() != null ? block.pins() : List.of();
+			if (CORE_KINDS.contains(block.kind()) && pins.isEmpty()) {
+				errors.add("Core block '" + block.title() + "' needs at least one pin");
+			}
+			for (GeneratedDayPlan.GeneratedDayPin pin : pins) {
+				if (pin.name() == null || pin.name().isBlank()) {
+					errors.add("Pin is missing a name");
+					continue;
+				}
+				if (PinMapsUrlBuilder.isDestinationOnlyName(pin.name(), destination)) {
+					errors.add("Pin name must not be the destination: " + pin.name());
+				}
+				if (looksGeneric(pin.name(), destination)) {
+					errors.add("Pin name is generic: " + pin.name());
+				}
+				if (isCoreRole(pin.role()) || CORE_KINDS.contains(block.kind())) {
+					hasCorePin = true;
+				}
+				allPins.add(pin);
+			}
+		}
+
+		if (!hasCorePin) {
+			errors.add("Day is missing a core venue pin");
+		}
+		if (allPins.size() >= 2 && allSameCoordinates(allPins)) {
+			errors.add("All pins share the same coordinates");
+		}
+		return errors;
+	}
+
+	public static boolean looksGeneric(String value, String destination) {
+		String text = PinMapsUrlBuilder.normalize(value);
+		if (text.isBlank()) {
+			return true;
+		}
+		String city = PinMapsUrlBuilder.normalize(PinMapsUrlBuilder.destinationCity(destination));
+		if (!city.isBlank() && (text.equals("meal in " + city)
+				|| text.equals("check in and orient")
+				|| text.equals(city + " highlight")
+				|| text.startsWith("local cuisine in " + city)
+				|| text.startsWith(city + " leisure stop")
+				|| text.startsWith(city + " trail / outdoor")
+				|| text.equals("orient")
+				|| text.equals("check in"))) {
+			return true;
+		}
+		return text.equals("activity") || text.equals("food") || text.equals("meal");
+	}
+
+	private static boolean isCoreRole(DayPinRole role) {
+		return role == DayPinRole.TRAILHEAD
+				|| role == DayPinRole.HUT
+				|| role == DayPinRole.VIEWPOINT
+				|| role == DayPinRole.RESTAURANT
+				|| role == DayPinRole.MUSEUM
+				|| role == DayPinRole.BEACH
+				|| role == DayPinRole.CAMP
+				|| role == DayPinRole.LODGING
+				|| role == DayPinRole.STOP;
+	}
+
+	private static boolean allSameCoordinates(List<GeneratedDayPlan.GeneratedDayPin> pins) {
+		GeneratedDayPlan.GeneratedDayPin firstWithCoords = pins.stream()
+				.filter(PinMapsUrlBuilder::hasCoords)
+				.findFirst()
+				.orElse(null);
+		if (firstWithCoords == null) {
+			return false;
+		}
+		return pins.stream().filter(PinMapsUrlBuilder::hasCoords)
+				.allMatch(pin -> PinMapsUrlBuilder.sameCoords(firstWithCoords, pin));
+	}
+
+	public static String cityKey(String destination) {
+		return PinMapsUrlBuilder.destinationCity(destination);
+	}
+
+	public static String normalize(String value) {
+		return value == null ? "" : value.toLowerCase(Locale.ROOT);
+	}
+}
diff --git a/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlanJsonParser.java b/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlanJsonParser.java
new file mode 100644
index 0000000..92be110
--- /dev/null
+++ b/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlanJsonParser.java
@@ -0,0 +1,209 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import com.duszek.pindrop.entity.DayPinRole;
+import com.duszek.pindrop.entity.DayRole;
+import com.duszek.pindrop.entity.ExternalLinkType;
+import com.duszek.pindrop.entity.PhotoConfidence;
+import com.duszek.pindrop.entity.TimeFlexibility;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.time.LocalDate;
+import java.time.LocalTime;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+public final class DayPlanJsonParser {
+
+	private DayPlanJsonParser() {
+	}
+
+	public static List<GeneratedDayPlan> parseDays(JsonMapper jsonMapper, String raw) {
+		JsonNode root = jsonMapper.readTree(extractJson(raw));
+		JsonNode daysNode = root.has("days") ? root.get("days") : root;
+		if (!daysNode.isArray()) {
+			throw new IllegalArgumentException("Day plan JSON is missing days[]");
+		}
+		List<GeneratedDayPlan> days = new ArrayList<>();
+		for (JsonNode dayNode : daysNode) {
+			days.add(parseDay(dayNode));
+		}
+		return days;
+	}
+
+	private static GeneratedDayPlan parseDay(JsonNode node) {
+		List<String> themes = new ArrayList<>();
+		if (node.get("themes") != null && node.get("themes").isArray()) {
+			node.get("themes").forEach(item -> {
+				if (!item.isNull()) {
+					themes.add(item.asString());
+				}
+			});
+		}
+		JsonNode statsNode = node.get("stats");
+		GeneratedDayPlan.Stats stats = new GeneratedDayPlan.Stats(
+				doubleOrNull(statsNode, "distanceKm"),
+				text(statsNode, "durationLabel"),
+				intOrNull(statsNode, "elevationM"),
+				intOrNull(statsNode, "costMin"),
+				intOrNull(statsNode, "costMax"),
+				firstNonBlank(text(statsNode, "currency"), "EUR"));
+
+		List<GeneratedDayPlan.GeneratedDayBlock> blocks = new ArrayList<>();
+		JsonNode blocksNode = node.get("blocks");
+		if (blocksNode != null && blocksNode.isArray()) {
+			blocksNode.forEach(block -> blocks.add(parseBlock(block)));
+		}
+
+		return new GeneratedDayPlan(
+				node.path("dayNumber").asInt(1),
+				parseDate(text(node, "date")),
+				text(node, "title"),
+				text(node, "narrative"),
+				themes,
+				enumOrNull(text(node, "dayRole"), DayRole.class),
+				text(node, "activityDomain"),
+				stats,
+				blocks);
+	}
+
+	private static GeneratedDayPlan.GeneratedDayBlock parseBlock(JsonNode node) {
+		List<GeneratedDayPlan.GeneratedDayLink> links = new ArrayList<>();
+		if (node.get("links") != null && node.get("links").isArray()) {
+			node.get("links").forEach(link -> {
+				String url = text(link, "url");
+				if (url != null) {
+					links.add(new GeneratedDayPlan.GeneratedDayLink(
+							enumOrDefault(text(link, "type"), ExternalLinkType.class, ExternalLinkType.OTHER),
+							url,
+							firstNonBlank(text(link, "label"), url)));
+				}
+			});
+		}
+		List<GeneratedDayPlan.GeneratedDayPin> pins = new ArrayList<>();
+		if (node.get("pins") != null && node.get("pins").isArray()) {
+			node.get("pins").forEach(pin -> pins.add(parsePin(pin)));
+		}
+		List<GeneratedDayPlan.GeneratedDayBlock> alternatives = new ArrayList<>();
+		if (node.get("alternatives") != null && node.get("alternatives").isArray()) {
+			node.get("alternatives").forEach(alt -> alternatives.add(parseBlock(alt)));
+		}
+		return new GeneratedDayPlan.GeneratedDayBlock(
+				enumOrDefault(text(node, "kind"), DayBlockKind.class, DayBlockKind.CITY_WALK),
+				parseTime(text(node, "startTime"), LocalTime.of(9, 0)),
+				parseTime(text(node, "endTime"), null),
+				enumOrNull(text(node, "flexibility"), TimeFlexibility.class),
+				firstNonBlank(text(node, "title"), "Untitled block"),
+				text(node, "narrative"),
+				text(node, "logistics"),
+				text(node, "costLabel"),
+				intOrNull(node, "costMin"),
+				intOrNull(node, "costMax"),
+				text(node, "photoUrl"),
+				enumOrNull(text(node, "photoConfidence"), PhotoConfidence.class),
+				text(node, "routeSummary"),
+				links,
+				pins,
+				alternatives);
+	}
+
+	private static GeneratedDayPlan.GeneratedDayPin parsePin(JsonNode node) {
+		return new GeneratedDayPlan.GeneratedDayPin(
+				firstNonBlank(text(node, "name"), "Unnamed pin"),
+				enumOrDefault(text(node, "role"), DayPinRole.class, DayPinRole.STOP),
+				doubleOrNull(node, "lat"),
+				doubleOrNull(node, "lng"),
+				text(node, "placeId"),
+				text(node, "mapsUrl"),
+				text(node, "address"),
+				text(node, "costLabel"));
+	}
+
+	private static String extractJson(String raw) {
+		if (raw == null) {
+			return "{}";
+		}
+		int start = raw.indexOf('{');
+		int end = raw.lastIndexOf('}');
+		if (start >= 0 && end > start) {
+			return raw.substring(start, end + 1);
+		}
+		return raw;
+	}
+
+	private static String text(JsonNode node, String field) {
+		if (node == null || node.isMissingNode() || node.isNull() || !node.has(field) || node.get(field).isNull()) {
+			return null;
+		}
+		String value = node.get(field).asString();
+		return value == null || value.isBlank() || "null".equalsIgnoreCase(value) ? null : value.trim();
+	}
+
+	private static Integer intOrNull(JsonNode node, String field) {
+		if (node == null || !node.has(field) || node.get(field).isNull()) {
+			return null;
+		}
+		try {
+			return node.get(field).asInt();
+		} catch (Exception ex) {
+			return null;
+		}
+	}
+
+	private static Double doubleOrNull(JsonNode node, String field) {
+		if (node == null || !node.has(field) || node.get(field).isNull()) {
+			return null;
+		}
+		try {
+			return node.get(field).asDouble();
+		} catch (Exception ex) {
+			return null;
+		}
+	}
+
+	private static LocalDate parseDate(String value) {
+		if (value == null) {
+			return LocalDate.now();
+		}
+		return LocalDate.parse(value.substring(0, Math.min(10, value.length())));
+	}
+
+	private static LocalTime parseTime(String value, LocalTime fallback) {
+		if (value == null || value.isBlank()) {
+			return fallback;
+		}
+		String trimmed = value.length() == 5 ? value + ":00" : value;
+		try {
+			return LocalTime.parse(trimmed);
+		} catch (Exception ex) {
+			return fallback;
+		}
+	}
+
+	private static <E extends Enum<E>> E enumOrNull(String value, Class<E> type) {
+		if (value == null) {
+			return null;
+		}
+		try {
+			return Enum.valueOf(type, value.trim().toUpperCase(Locale.ROOT));
+		} catch (IllegalArgumentException ex) {
+			return null;
+		}
+	}
+
+	private static <E extends Enum<E>> E enumOrDefault(String value, Class<E> type, E fallback) {
+		E parsed = enumOrNull(value, type);
+		return parsed != null ? parsed : fallback;
+	}
+
+	private static String firstNonBlank(String... values) {
+		for (String value : values) {
+			if (value != null && !value.isBlank()) {
+				return value;
+			}
+		}
+		return null;
+	}
+}
diff --git a/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlaybooks.java b/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlaybooks.java
new file mode 100644
index 0000000..6f6e8fb
--- /dev/null
+++ b/src/main/java/com/duszek/pindrop/provider/dayplan/DayPlaybooks.java
@@ -0,0 +1,95 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import com.duszek.pindrop.entity.DayPinRole;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+public final class DayPlaybooks {
+
+	private DayPlaybooks() {
+	}
+
+	public record Playbook(DayBlockKind kind, List<DayPinRole> expectedPins, String promptHint) {
+	}
+
+	public static final Playbook TREK = new Playbook(
+			DayBlockKind.TREK,
+			List.of(DayPinRole.PARKING, DayPinRole.TRAILHEAD, DayPinRole.VIEWPOINT, DayPinRole.HUT),
+			"""
+					TREK playbook: one long time window (e.g. 08:30–17:00). Pins MUST include a named parking or trailhead, \
+					at least one viewpoint/summit, and a hut/refuge/restaurant on the trail when it exists. \
+					Add a shorter alternative (turn around at a named lake or hut). Never pin the destination city.""");
+
+	public static final Playbook CITY_WALK = new Playbook(
+			DayBlockKind.CITY_WALK,
+			List.of(DayPinRole.STOP, DayPinRole.VIEWPOINT),
+			"""
+					CITY_WALK playbook: a walking sequence with routeSummary like 'Praça do Comércio → Rua Augusta → Rossio'. \
+					Each stop is its own pin with a real street/square/building name and distinct coordinates.""");
+
+	public static final Playbook MUSEUM = new Playbook(
+			DayBlockKind.MUSEUM,
+			List.of(DayPinRole.MUSEUM, DayPinRole.RESTAURANT),
+			"""
+					MUSEUM playbook: a named museum/gallery pin plus nearby cafe/restaurant. Include ticket logistics and a TICKETS link when known.""");
+
+	public static final Playbook BEACH = new Playbook(
+			DayBlockKind.BEACH,
+			List.of(DayPinRole.BEACH, DayPinRole.RESTAURANT),
+			"""
+					BEACH playbook: a specific beach or cove name (not the city), access/parking pin if useful, and a beach bar or lunch pin.""");
+
+	public static final Playbook CAMP = new Playbook(
+			DayBlockKind.CAMP,
+			List.of(DayPinRole.CAMP, DayPinRole.SHOP, DayPinRole.TRAILHEAD),
+			"""
+					CAMP playbook: named campsite/bivouac, a grocery/shop for supplies, and an optional short trail from camp.""");
+
+	public static Playbook of(DayBlockKind kind) {
+		return switch (kind) {
+			case TREK -> TREK;
+			case CITY_WALK -> CITY_WALK;
+			case MUSEUM -> MUSEUM;
+			case BEACH -> BEACH;
+			case CAMP -> CAMP;
+			default -> new Playbook(kind, List.of(DayPinRole.STOP), kind.name() + " uses the same block+pins schema.");
+		};
+	}
+
+	public static DayBlockKind inferKind(List<String> interests, int dayIndex, int totalDays) {
+		Set<String> tags = interests == null
+				? Set.of()
+				: interests.stream().map(value -> value.toUpperCase(Locale.ROOT)).collect(java.util.stream.Collectors.toSet());
+		if (dayIndex == 0) {
+			return DayBlockKind.ARRIVAL;
+		}
+		if (dayIndex == totalDays - 1) {
+			return DayBlockKind.CITY_WALK;
+		}
+		if (containsAny(tags, "HIKING", "MOUNTAINS", "ADVENTURE", "SCENIC_VIEWS")) {
+			return DayBlockKind.TREK;
+		}
+		if (containsAny(tags, "BEACHES", "WATER_ACTIVITIES")) {
+			return DayBlockKind.BEACH;
+		}
+		if (containsAny(tags, "MUSEUMS", "CULTURE", "HISTORY", "ARCHITECTURE")) {
+			return DayBlockKind.MUSEUM;
+		}
+		if (containsAny(tags, "WILDLIFE")) {
+			return DayBlockKind.CAMP;
+		}
+		return DayBlockKind.CITY_WALK;
+	}
+
+	private static boolean containsAny(Set<String> tags, String... values) {
+		for (String value : values) {
+			if (tags.contains(value)) {
+				return true;
+			}
+		}
+		return false;
+	}
+}
