@@ -0,0 +1,67 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.exception.UnprocessableEntityException;
+import com.duszek.pindrop.provider.ai.claude.AnthropicMessagesClient;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Component;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+@Slf4j
+@Component
+@RequiredArgsConstructor
+public class ClaudeFirstDayPlanProvider implements DayPlanAiProvider {
+
+	private final AnthropicMessagesClient anthropicMessagesClient;
+	private final EditorialDayPlanStub editorialDayPlanStub;
+	private final JsonMapper jsonMapper;
+
+	@Override
+	public List<GeneratedDayPlan> generateDayPlans(DeepDayPlanRequest request) {
+		if (!anthropicMessagesClient.isConfigured()) {
+			return editorialDayPlanStub.generate(request);
+		}
+
+		String user = EditorialDayPlanPromptBuilder.buildDeepPrompt(request);
+		try {
+			List<GeneratedDayPlan> first = complete(user);
+			List<String> errors = validateAll(first, request.trip().destination());
+			if (errors.isEmpty()) {
+				return first;
+			}
+			log.info("Claude day plan failed concreteness checks, retrying once: {}", errors);
+			List<GeneratedDayPlan> retry = complete(
+					user + "\n\n" + EditorialDayPlanPromptBuilder.retryPrompt(String.join("; ", errors)));
+			List<String> retryErrors = validateAll(retry, request.trip().destination());
+			if (retryErrors.isEmpty()) {
+				return retry;
+			}
+			throw new UnprocessableEntityException(
+					"Could not generate a specific day plan. Please regenerate. " + String.join("; ", retryErrors));
+		} catch (UnprocessableEntityException ex) {
+			throw ex;
+		} catch (Exception ex) {
+			log.warn("Claude deep generation failed, using editorial stub: {}", ex.getMessage());
+			return editorialDayPlanStub.generate(request);
+		}
+	}
+
+	private List<GeneratedDayPlan> complete(String user) {
+		String raw = anthropicMessagesClient.complete(
+				EditorialDayPlanPromptBuilder.systemPrompt(), user, true);
+		return DayPlanJsonParser.parseDays(jsonMapper, raw);
+	}
+
+	private static List<String> validateAll(List<GeneratedDayPlan> days, String destination) {
+		if (days == null || days.isEmpty()) {
+			return List.of("No days returned");
+		}
+		return days.stream()
+				.flatMap(day -> DayPlanConcretenessValidator.validate(day, destination).stream()
+						.map(error -> "Day " + day.dayNumber() + ": " + error))
+				.collect(Collectors.toList());
+	}
+}
