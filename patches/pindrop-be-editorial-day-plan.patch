+++ b/src/main/java/com/duszek/pindrop/service/DayPlanMapper.java
@@ -0,0 +1,179 @@
+package com.duszek.pindrop.service;
+
+import com.duszek.pindrop.dto.planning.DayBlockLinkResponse;
+import com.duszek.pindrop.dto.planning.DayBlockResponse;
+import com.duszek.pindrop.dto.planning.DayPinResponse;
+import com.duszek.pindrop.dto.planning.DayPlanResponse;
+import com.duszek.pindrop.dto.planning.DayPlanStatsResponse;
+import com.duszek.pindrop.entity.Trip;
+import com.duszek.pindrop.entity.TripDayBlock;
+import com.duszek.pindrop.entity.TripDayLink;
+import com.duszek.pindrop.entity.TripDayPin;
+import com.duszek.pindrop.entity.TripDayPlan;
+import com.duszek.pindrop.provider.dayplan.GeneratedDayPlan;
+
+import java.util.List;
+
+public final class DayPlanMapper {
+
+	private DayPlanMapper() {
+	}
+
+	public static DayPlanResponse toResponse(TripDayPlan plan) {
+		List<DayBlockResponse> blocks = plan.getBlocks().stream()
+				.filter(block -> block.getParentBlock() == null)
+				.map(DayPlanMapper::toBlockResponse)
+				.toList();
+		return DayPlanResponse.builder()
+				.dayNumber(plan.getDayNumber())
+				.date(plan.getDayDate())
+				.title(plan.getTitle())
+				.narrative(plan.getNarrative())
+				.themes(plan.getThemes() != null ? plan.getThemes() : List.of())
+				.dayRole(plan.getDayRole())
+				.activityDomain(plan.getActivityDomain())
+				.stats(DayPlanStatsResponse.builder()
+						.distanceKm(plan.getDistanceKm())
+						.durationLabel(plan.getDurationLabel())
+						.elevationM(plan.getElevationM())
+						.costMin(plan.getCostMin())
+						.costMax(plan.getCostMax())
+						.currency(plan.getCurrency())
+						.build())
+				.blocks(blocks)
+				.build();
+	}
+
+	public static TripDayPlan toEntity(Trip trip, GeneratedDayPlan generated) {
+		TripDayPlan plan = new TripDayPlan();
+		plan.setTrip(trip);
+		plan.setDayNumber(generated.dayNumber());
+		plan.setDayDate(generated.date());
+		plan.setTitle(generated.title());
+		plan.setNarrative(generated.narrative());
+		plan.setThemes(generated.themes() != null ? generated.themes() : List.of());
+		plan.setDayRole(generated.dayRole());
+		plan.setActivityDomain(generated.activityDomain());
+		if (generated.stats() != null) {
+			plan.setDistanceKm(generated.stats().distanceKm());
+			plan.setDurationLabel(generated.stats().durationLabel());
+			plan.setElevationM(generated.stats().elevationM());
+			plan.setCostMin(generated.stats().costMin());
+			plan.setCostMax(generated.stats().costMax());
+			plan.setCurrency(generated.stats().currency() != null ? generated.stats().currency() : "EUR");
+		}
+		int order = 0;
+		if (generated.blocks() != null) {
+			for (GeneratedDayPlan.GeneratedDayBlock block : generated.blocks()) {
+				plan.addBlock(toBlockEntity(block, order++));
+			}
+		}
+		return plan;
+	}
+
+	private static TripDayBlock toBlockEntity(GeneratedDayPlan.GeneratedDayBlock generated, int sortOrder) {
+		TripDayBlock block = new TripDayBlock();
+		block.setKind(generated.kind());
+		block.setStartTime(generated.startTime());
+		block.setEndTime(generated.endTime());
+		block.setFlexibility(generated.flexibility());
+		block.setTitle(generated.title());
+		block.setNarrative(generated.narrative());
+		block.setLogistics(generated.logistics());
+		block.setCostLabel(generated.costLabel());
+		block.setCostMin(generated.costMin());
+		block.setCostMax(generated.costMax());
+		block.setPhotoUrl(generated.photoUrl());
+		block.setPhotoConfidence(generated.photoConfidence());
+		block.setRouteSummary(generated.routeSummary());
+		block.setSortOrder(sortOrder);
+
+		int pinOrder = 0;
+		if (generated.pins() != null) {
+			for (GeneratedDayPlan.GeneratedDayPin pin : generated.pins()) {
+				block.addPin(toPinEntity(pin, pinOrder++));
+			}
+		}
+		int linkOrder = 0;
+		if (generated.links() != null) {
+			for (GeneratedDayPlan.GeneratedDayLink link : generated.links()) {
+				block.addLink(toLinkEntity(link, linkOrder++));
+			}
+		}
+		int altOrder = 0;
+		if (generated.alternatives() != null) {
+			for (GeneratedDayPlan.GeneratedDayBlock alternative : generated.alternatives()) {
+				TripDayBlock altEntity = toBlockEntity(alternative, altOrder++);
+				block.addAlternative(altEntity);
+			}
+		}
+		return block;
+	}
+
+	private static TripDayPin toPinEntity(GeneratedDayPlan.GeneratedDayPin generated, int sortOrder) {
+		TripDayPin pin = new TripDayPin();
+		pin.setName(generated.name());
+		pin.setRole(generated.role());
+		pin.setLat(generated.lat());
+		pin.setLng(generated.lng());
+		pin.setPlaceId(generated.placeId());
+		pin.setMapsUrl(generated.mapsUrl());
+		pin.setAddress(generated.address());
+		pin.setCostLabel(generated.costLabel());
+		pin.setSortOrder(sortOrder);
+		return pin;
+	}
+
+	private static TripDayLink toLinkEntity(GeneratedDayPlan.GeneratedDayLink generated, int sortOrder) {
+		TripDayLink link = new TripDayLink();
+		link.setLinkType(generated.type());
+		link.setUrl(generated.url());
