+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import com.duszek.pindrop.entity.DayPinRole;
+import com.duszek.pindrop.entity.DayRole;
+import com.duszek.pindrop.entity.ExternalLinkType;
+import com.duszek.pindrop.entity.ProposalType;
+import com.duszek.pindrop.entity.TimeFlexibility;
+import com.duszek.pindrop.provider.ai.TripPlanGenerationRequest;
+import org.springframework.stereotype.Component;
+
+import java.time.LocalDate;
+import java.time.LocalTime;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+@Component
+public class EditorialDayPlanStub {
+
+	public List<GeneratedDayPlan> generate(DeepDayPlanRequest request) {
+		TripPlanGenerationRequest trip = request.trip();
+		int totalDays = (int) java.time.temporal.ChronoUnit.DAYS.between(trip.startDate(), trip.endDate()) + 1;
+		totalDays = Math.max(1, totalDays);
+		List<GeneratedDayPlan> days = new ArrayList<>();
+		for (int i = 0; i < totalDays; i++) {
+			int dayNumber = i + 1;
+			if (request.dayNumber() != null && request.dayNumber() != dayNumber) {
+				continue;
+			}
+			days.add(buildDay(trip, request.proposalType(), dayNumber, totalDays));
+		}
+		return days;
+	}
+
+	private GeneratedDayPlan buildDay(
+			TripPlanGenerationRequest trip,
+			ProposalType proposalType,
+			int dayNumber,
+			int totalDays) {
+		String city = PinMapsUrlBuilder.destinationCity(trip.destination());
+		String country = PinMapsUrlBuilder.destinationCountry(trip.destination());
+		String region = country != null ? country : city;
+		DayBlockKind focus = DayPlaybooks.inferKind(trip.interests(), dayNumber - 1, totalDays);
+		if (proposalType == ProposalType.INTENSE && focus == DayBlockKind.CITY_WALK && dayNumber > 1) {
+			focus = DayBlockKind.TREK;
+		}
+		if (proposalType == ProposalType.RELAXED && focus == DayBlockKind.TREK) {
+			focus = DayBlockKind.BEACH;
+		}
+
+		LocalDate date = trip.startDate().plusDays(dayNumber - 1);
+		double baseLat = trip.lat();
+		double baseLng = trip.lng();
+		List<GeneratedDayPlan.GeneratedDayBlock> blocks = switch (focus) {
+			case TREK -> trekBlocks(city, region, baseLat, baseLng, dayNumber);
+			case BEACH -> beachBlocks(city, region, baseLat, baseLng, dayNumber);
+			case MUSEUM -> museumBlocks(city, region, baseLat, baseLng, dayNumber);
+			case CAMP -> campBlocks(city, region, baseLat, baseLng, dayNumber);
+			case ARRIVAL -> arrivalBlocks(city, region, baseLat, baseLng, dayNumber);
+			default -> cityWalkBlocks(city, region, baseLat, baseLng, dayNumber);
+		};
+
+		GeneratedDayPlan.Stats stats = switch (focus) {
+			case TREK -> new GeneratedDayPlan.Stats(14.0, "8–9 h on trail", 1100, 25, 40, "EUR");
+			case BEACH -> new GeneratedDayPlan.Stats(6.0, "5 h by the water", null, 20, 45, "EUR");
+			case MUSEUM -> new GeneratedDayPlan.Stats(7.0, "6 h in town", null, 35, 70, "EUR");
+			case CAMP -> new GeneratedDayPlan.Stats(8.0, "camp + short loop", 240, 15, 35, "EUR");
+			default -> new GeneratedDayPlan.Stats(7.0, "~6 h walking", null, 40, 75, "EUR");
+		};
+
+		return new GeneratedDayPlan(
+				dayNumber,
+				date,
+				titleFor(focus, city, dayNumber),
+				narrativeFor(focus, city),
+				themesFor(focus, city),
+				dayRoleFor(focus, dayNumber, totalDays),
+				domainFor(focus),
+				stats,
+				blocks);
+	}
+
+	private List<GeneratedDayPlan.GeneratedDayBlock> trekBlocks(
+			String city, String region, double lat, double lng, int dayNumber) {
+		GeneratedDayPlan.GeneratedDayPin parking = pin(
+				named(city, "Valley trailhead parking"), DayPinRole.PARKING, offset(lat, lng, dayNumber, 1),
+				null, "Arrive before 08:00 — lot fills early");
+		GeneratedDayPlan.GeneratedDayPin trailhead = pin(
+				named(city, "Ridge trailhead"), DayPinRole.TRAILHEAD, offset(lat, lng, dayNumber, 2),
+				null, null);
+		GeneratedDayPlan.GeneratedDayPin viewpoint = pin(
+				named(city, "High tarn overlook"), DayPinRole.VIEWPOINT, offset(lat, lng, dayNumber, 3),
+				null, null);
+		GeneratedDayPlan.GeneratedDayPin hut = pin(
+				named(city, "Mountain hut"), DayPinRole.HUT, offset(lat, lng, dayNumber, 4),
+				null, "Lunch €12–18");
+		GeneratedDayPlan.GeneratedDayBlock shortcut = block(
+				DayBlockKind.TREK, LocalTime.of(8, 30), LocalTime.of(13, 0),
+				"Shorter loop to the tarn",
+				"Turn around at the overlook if weather or legs say so.",
+				null, List.of(trailhead, viewpoint), List.of());
+		GeneratedDayPlan.GeneratedDayBlock trek = block(
+				DayBlockKind.TREK, LocalTime.of(8, 30), LocalTime.of(17, 0),
+				named(city, "Ridge traverse"),
+				"Main day on the trail. Own pace; carry 2 L of water. Shortcut: turn around at the tarn.",
+				"National-park ticket if in season. Hut takes cash.",
+				List.of(parking, trailhead, viewpoint, hut),
+				List.of(shortcut));
+		trek = withLinks(trek, List.of(
+				new GeneratedDayPlan.GeneratedDayLink(
+						ExternalLinkType.ALLTRAILS, "https://www.alltrails.com", "Trail notes"),
+				new GeneratedDayPlan.GeneratedDayLink(
+						ExternalLinkType.ARTICLE, "https://www.outdooractive.com", "Route article")));
+		GeneratedDayPlan.GeneratedDayBlock shop = block(
+				DayBlockKind.EVENING, LocalTime.of(18, 30), LocalTime.of(20, 0),
+				named(city, "Village grocery"),
+				"Resupply water and snacks. Optional village stroll — do not pin the destination city.",
+				"Card usually fine; bakery closes ~19:00.",
+				List.of(pin(named(city, "Village grocery"), DayPinRole.SHOP, offset(lat, lng, dayNumber, 5), null, null)),
+				List.of());
+		return List.of(
+				transitBlock(city, region, lat, lng, dayNumber),
+				trek,
+				shop);
+	}
+
+	private List<GeneratedDayPlan.GeneratedDayBlock> cityWalkBlocks(
+			String city, String region, double lat, double lng, int dayNumber) {
+		GeneratedDayPlan.GeneratedDayPin a = pin(named(city, "Harbor square"), DayPinRole.STOP, offset(lat, lng, dayNumber, 1), null, null);
+		GeneratedDayPlan.GeneratedDayPin b = pin(named(city, "Arcade street"), DayPinRole.STOP, offset(lat, lng, dayNumber, 2), null, null);
+		GeneratedDayPlan.GeneratedDayPin c = pin(named(city, "Hill viewpoint"), DayPinRole.VIEWPOINT, offset(lat, lng, dayNumber, 3), null, null);
+		GeneratedDayPlan.GeneratedDayPin lunch = pin(named(city, "Family tasca"), DayPinRole.RESTAURANT, offset(lat, lng, dayNumber, 4), "cash preferred", "€15–25");
+		GeneratedDayPlan.GeneratedDayBlock walk = block(
+				DayBlockKind.CITY_WALK, LocalTime.of(9, 30), LocalTime.of(13, 0),
+				named(city, "Old town loop"),
+				"Unhurried walk through the historic core. Pause for photos at the viewpoint.",
+				null,
+				List.of(a, b, c),
+				List.of());
+		walk = walk.withPins(walk.pins());
+		GeneratedDayPlan.GeneratedDayBlock food = block(
+				DayBlockKind.FOOD, LocalTime.of(13, 15), LocalTime.of(14, 45),
+				named(city, "Family tasca"),
+				"Small dining room, daily board. Cash only at lunch.",
+				"No reservation needed before 13:30.",
+				List.of(lunch),
+				List.of());
+		GeneratedDayPlan.GeneratedDayBlock evening = block(
+				DayBlockKind.EVENING, LocalTime.of(18, 30), LocalTime.of(21, 0),
+				named(city, "Riverfront sunset"),
+				"Golden hour along the water, then a glass nearby.",
+				null,
+				List.of(pin(named(city, "Riverfront belvedere"), DayPinRole.VIEWPOINT, offset(lat, lng, dayNumber, 5), null, null)),
+				List.of());
+		return List.of(walk.withAlternatives(walk.alternatives()), food, evening);
+	}
+
+	private List<GeneratedDayPlan.GeneratedDayBlock> museumBlocks(
+			String city, String region, double lat, double lng, int dayNumber) {
+		GeneratedDayPlan.GeneratedDayPin museum = pin(
+				named(city, "City museum"), DayPinRole.MUSEUM, offset(lat, lng, dayNumber, 1), null, "€8–14");
+		GeneratedDayPlan.GeneratedDayPin cafe = pin(
+				named(city, "Museum cafe"), DayPinRole.RESTAURANT, offset(lat, lng, dayNumber, 2), null, "€6–12");
+		GeneratedDayPlan.GeneratedDayBlock visit = withLinks(block(
+				DayBlockKind.MUSEUM, LocalTime.of(10, 0), LocalTime.of(13, 0),
+				named(city, "City museum"),
+				"Morning in the permanent collection. Buy timed tickets if the queue looks long.",
+				"Cloakroom for bags. Last entry 30 minutes before close.",
+				List.of(museum, cafe),
+				List.of()),
+				List.of(new GeneratedDayPlan.GeneratedDayLink(
+						ExternalLinkType.TICKETS, "https://www.google.com/search?q=" + named(city, "museum tickets"),
+						"Tickets")));
+		GeneratedDayPlan.GeneratedDayBlock walk = block(
+				DayBlockKind.CITY_WALK, LocalTime.of(14, 30), LocalTime.of(17, 30),
+				named(city, "Gallery quarter"),
+				"After the museum, wander the surrounding streets and a second smaller gallery.",
+				null,
+				List.of(
+						pin(named(city, "Side-street gallery"), DayPinRole.MUSEUM, offset(lat, lng, dayNumber, 3), null, null),
+						pin(named(city, "Ceramic workshop courtyard"), DayPinRole.STOP, offset(lat, lng, dayNumber, 4), null, null)),
+				List.of());
+		return List.of(visit, walk);
+	}
+
+	private List<GeneratedDayPlan.GeneratedDayBlock> beachBlocks(
+			String city, String region, double lat, double lng, int dayNumber) {
+		GeneratedDayPlan.GeneratedDayPin beach = pin(
+				named(city, "Cove beach"), DayPinRole.BEACH, offset(lat, lng, dayNumber, 1), null, null);
+		GeneratedDayPlan.GeneratedDayPin parking = pin(
+				named(city, "Cove parking"), DayPinRole.PARKING, offset(lat, lng, dayNumber, 2), null, "Paid from 09:00");
+		GeneratedDayPlan.GeneratedDayPin lunch = pin(
+				named(city, "Beach shack"), DayPinRole.RESTAURANT, offset(lat, lng, dayNumber, 3), "cash", "€12–20");
+		GeneratedDayPlan.GeneratedDayBlock swim = block(
+				DayBlockKind.BEACH, LocalTime.of(10, 0), LocalTime.of(16, 0),
+				named(city, "Cove beach day"),
+				"Swim and shade. Bring water; the shack closes if wind picks up.",
+				"No lifeguard after 18:00.",
+				List.of(parking, beach, lunch),
+				List.of());
+		return List.of(swim);
+	}
+
+	private List<GeneratedDayPlan.GeneratedDayBlock> campBlocks(
+			String city, String region, double lat, double lng, int dayNumber) {
+		GeneratedDayPlan.GeneratedDayPin camp = pin(
+				named(city, "Pine clearing campsite"), DayPinRole.CAMP, offset(lat, lng, dayNumber, 1), null, null);
+		GeneratedDayPlan.GeneratedDayPin shop = pin(
+				named(city, "Trail grocery"), DayPinRole.SHOP, offset(lat, lng, dayNumber, 2), null, null);
+		GeneratedDayPlan.GeneratedDayPin trail = pin(
+				named(city, "Camp loop trailhead"), DayPinRole.TRAILHEAD, offset(lat, lng, dayNumber, 3), null, null);
+		return List.of(
+				block(DayBlockKind.CAMP, LocalTime.of(16, 0), LocalTime.of(20, 0),
+						named(city, "Pitch camp"),
+						"Set camp, cook, and a short dusk loop from the trailhead.",
+						"Quiet hours from 22:00. Water tap by the warden hut.",
+						List.of(shop, camp, trail),
+						List.of()));
+	}
+
+	private List<GeneratedDayPlan.GeneratedDayBlock> arrivalBlocks(
+			String city, String region, double lat, double lng, int dayNumber) {
+		GeneratedDayPlan.GeneratedDayPin lodging = pin(
+				named(city, "Hillside guesthouse"), DayPinRole.LODGING, offset(lat, lng, dayNumber, 1), null, null);
+		GeneratedDayPlan.GeneratedDayPin dinner = pin(
+				named(city, "Station tavern"), DayPinRole.RESTAURANT, offset(lat, lng, dayNumber, 2), null, "€18–28");
+		return List.of(
+				block(DayBlockKind.ARRIVAL, LocalTime.of(15, 0), LocalTime.of(17, 0),
+						named(city, "Drop bags and orient"),
+						"Check in, unpack, and a short walk to understand the neighborhood — not a destination pin.",
+						"Confirm breakfast hours with the host.",
+						List.of(lodging),
+						List.of()),
+				block(DayBlockKind.FOOD, LocalTime.of(19, 0), LocalTime.of(21, 0),
+						named(city, "Station tavern"),
+						"Simple first-night dinner walking distance from the guesthouse.",
+						null,
+						List.of(dinner),
+						List.of()));
+	}
+
+	private GeneratedDayPlan.GeneratedDayBlock transitBlock(
+			String city, String region, double lat, double lng, int dayNumber) {
+		return block(
+				DayBlockKind.TRANSIT, LocalTime.of(7, 0), LocalTime.of(8, 0),
+				"Drive to the trailhead",
+				"Leave before the parking fills. Fill bottles in town.",
+				null,
+				List.of(pin(named(city, "Valley trailhead parking"), DayPinRole.PARKING, offset(lat, lng, dayNumber, 1), null, null)),
+				List.of());
+	}
+
+	private static GeneratedDayPlan.GeneratedDayBlock withLinks(
+			GeneratedDayPlan.GeneratedDayBlock block,
+			List<GeneratedDayPlan.GeneratedDayLink> links) {
+		return new GeneratedDayPlan.GeneratedDayBlock(
+				block.kind(), block.startTime(), block.endTime(), block.flexibility(), block.title(),
+				block.narrative(), block.logistics(), block.costLabel(), block.costMin(), block.costMax(),
+				block.photoUrl(), block.photoConfidence(), block.routeSummary(), links, block.pins(), block.alternatives());
+	}
+
+	private static GeneratedDayPlan.GeneratedDayBlock block(
+			DayBlockKind kind,
+			LocalTime start,
+			LocalTime end,
+			String title,
+			String narrative,
+			String logistics,
+			List<GeneratedDayPlan.GeneratedDayPin> pins,
+			List<GeneratedDayPlan.GeneratedDayBlock> alternatives) {
+		String route = kind == DayBlockKind.CITY_WALK && pins.size() >= 2
+				? pins.stream().map(GeneratedDayPlan.GeneratedDayPin::name).reduce((a, b) -> a + " → " + b).orElse(null)
+				: null;
+		return new GeneratedDayPlan.GeneratedDayBlock(
+				kind, start, end, TimeFlexibility.FIXED, title, narrative, logistics, null, null, null,
+				null, null, route, List.of(), pins, alternatives);
+	}
+
+	private static GeneratedDayPlan.GeneratedDayPin pin(
+			String name, DayPinRole role, double[] coords, String address, String cost) {
+		return new GeneratedDayPlan.GeneratedDayPin(
+				name, role, coords[0], coords[1], null, null, address, cost);
+	}
+
+	private static double[] offset(double lat, double lng, int dayNumber, int pinIndex) {
+		double dLat = (dayNumber * 0.012) + (pinIndex * 0.008);
+		double dLng = (dayNumber * 0.009) - (pinIndex * 0.006);
+		return new double[] { lat + dLat, lng + dLng };
+	}
+
+	private static String named(String city, String feature) {
+		return feature + " near " + city;
+	}
+
+	private static String titleFor(DayBlockKind kind, String city, int dayNumber) {
+		return switch (kind) {
+			case TREK -> "Ridge day · Early start · Hut lunch";
+			case BEACH -> "Cove swim · Slow afternoon";
+			case MUSEUM -> "Museum morning · Gallery streets";
+			case CAMP -> "Camp pitch · Dusk loop";
+			case ARRIVAL -> "Arrive · Neighborhood dinner";
+			default -> city + " on foot · Day " + dayNumber;
+		};
+	}
+
+	private static String narrativeFor(DayBlockKind kind, String city) {
+		return switch (kind) {
+			case TREK -> "Long mountain day outside " + city + ". Start before 8:00 — parking fills quickly. Carry lunch or eat at the hut.";
+			case BEACH -> "A specific cove rather than the city waterfront. Shade by midday; lunch at the shack on the sand.";
+			case MUSEUM -> "One major collection in the morning, then the streets around it. Tickets in advance on weekends.";
+			case CAMP -> "Pitch among the pines, shop for dinner, and a short loop from camp before dark.";
+			case ARRIVAL -> "Land, drop bags at a named guesthouse, and eat nearby. Keep the first evening light.";
+			default -> "A walking day through named streets and squares — not a generic loop of " + city + ".";
+		};
+	}
+
+	private static List<String> themesFor(DayBlockKind kind, String city) {
+		return switch (kind) {
+			case TREK -> List.of("Ridge traverse", "Early start", "Hut lunch");
+			case BEACH -> List.of("Cove swim", "Slow lunch");
+			case MUSEUM -> List.of("Permanent collection", "Gallery streets");
+			case CAMP -> List.of("Pitch camp", "Dusk loop");
+			case ARRIVAL -> List.of("Check-in", "First dinner");
+			default -> List.of("Old town", "Local table");
+		};
+	}
+
+	private static DayRole dayRoleFor(DayBlockKind kind, int dayNumber, int totalDays) {
+		if (dayNumber == 1) {
+			return DayRole.ARRIVAL;
+		}
+		if (dayNumber == totalDays) {
+			return DayRole.DEPARTURE;
+		}
+		return switch (kind) {
+			case TREK -> DayRole.EXCURSION;
+			case BEACH, CAMP -> DayRole.RELAX;
+			default -> DayRole.EXPLORE;
+		};
+	}
+
+	private static String domainFor(DayBlockKind kind) {
+		return switch (kind) {
+			case TREK -> "MOUNTAIN_TRAIL";
+			case MUSEUM -> "MUSEUM_GALLERY";
+			case BEACH -> "BEACH_LEISURE";
+			case CAMP -> "UNSTRUCTURED";
+			case FOOD -> "FOOD_DINING";
+			default -> "CITY_WALKING";
+		};
+	}
+
+	@SuppressWarnings("unused")
+	private static String localeCity(String city) {
+		return city == null ? "" : city.toLowerCase(Locale.ROOT);
+	}
+}
