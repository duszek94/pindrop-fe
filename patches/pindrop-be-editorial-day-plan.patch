@@ -0,0 +1,113 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.Objects;
+
+public final class PinMapsUrlBuilder {
+
+	private PinMapsUrlBuilder() {
+	}
+
+	public static boolean isDestinationOnlyName(String name, String destination) {
+		String normalizedName = normalize(name);
+		String city = normalize(destinationCity(destination));
+		return !normalizedName.isBlank() && !city.isBlank() && normalizedName.equals(city);
+	}
+
+	public static String build(GeneratedDayPlan.GeneratedDayPin pin, String destination) {
+		if (pin.placeId() != null && !pin.placeId().isBlank()) {
+			return "https://www.google.com/maps/search/?api=1&query_place_id="
+					+ encode(pin.placeId().trim());
+		}
+		if (hasCoords(pin)) {
+			return "https://www.google.com/maps/search/?api=1&query=" + pin.lat() + "," + pin.lng();
+		}
+
+		String name = blankToEmpty(pin.name());
+		String address = blankToEmpty(pin.address());
+		String country = destinationCountry(destination);
+		String city = destinationCity(destination);
+
+		if (!name.isBlank() && !address.isBlank() && !normalize(name).equals(normalize(address))) {
+			String query = country != null && !address.toLowerCase(Locale.ROOT).contains(country.toLowerCase(Locale.ROOT))
+					? name + ", " + address + ", " + country
+					: name + ", " + address;
+			return mapsQuery(query);
+		}
+
+		if (!name.isBlank() && !isDestinationOnlyName(name, destination) && destination != null && !destination.isBlank()) {
+			return mapsQuery(name + ", " + destination);
+		}
+
+		if (!name.isBlank() && country != null) {
+			return mapsQuery(name + ", " + country);
+		}
+
+		if (destination != null && !destination.isBlank()) {
+			return mapsQuery(destination);
+		}
+
+		if (city != null) {
+			return mapsQuery(city);
+		}
+
+		return pin.mapsUrl() != null ? pin.mapsUrl() : "";
+	}
+
+	public static GeneratedDayPlan.GeneratedDayPin withResolvedUrl(
+			GeneratedDayPlan.GeneratedDayPin pin,
+			String destination) {
+		String url = build(pin, destination);
+		return pin.withMaps(url.isBlank() ? pin.mapsUrl() : url);
+	}
+
+	public static boolean hasCoords(GeneratedDayPlan.GeneratedDayPin pin) {
+		return pin.lat() != null && pin.lng() != null
+				&& (Math.abs(pin.lat()) > 0.0001 || Math.abs(pin.lng()) > 0.0001);
+	}
+
+	public static String destinationCity(String destination) {
+		if (destination == null || destination.isBlank()) {
+			return null;
+		}
+		return destination.split(",")[0].trim();
+	}
+
+	public static String destinationCountry(String destination) {
+		if (destination == null || destination.isBlank()) {
+			return null;
+		}
+		String[] parts = destination.split(",");
+		return parts.length > 1 ? parts[parts.length - 1].trim() : null;
+	}
+
+	public static String normalize(String value) {
+		return value == null ? "" : value.trim().replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
+	}
+
+	private static String mapsQuery(String query) {
+		return "https://www.google.com/maps/search/?api=1&query=" + encode(query);
+	}
+
+	private static String encode(String value) {
+		return URLEncoder.encode(value, StandardCharsets.UTF_8);
+	}
+
+	private static String blankToEmpty(String value) {
+		return value == null ? "" : value.trim();
+	}
+
+	public static boolean sameCoords(GeneratedDayPlan.GeneratedDayPin left, GeneratedDayPlan.GeneratedDayPin right) {
+		if (!hasCoords(left) || !hasCoords(right)) {
+			return false;
+		}
+		return Objects.equals(round6(left.lat()), round6(right.lat()))
+				&& Objects.equals(round6(left.lng()), round6(right.lng()));
+	}
+
+	private static double round6(double value) {
+		return Math.round(value * 1_000_000d) / 1_000_000d;
+	}
+}
