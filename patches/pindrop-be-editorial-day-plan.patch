@@ -0,0 +1,64 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import com.duszek.pindrop.entity.DayPinRole;
+import com.duszek.pindrop.entity.ProposalType;
+import com.duszek.pindrop.provider.ai.TripPlanGenerationRequest;
+import org.junit.jupiter.api.Test;
+
+import java.time.LocalDate;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class EditorialDayPlanStubTest {
+
+	private final EditorialDayPlanStub stub = new EditorialDayPlanStub();
+
+	@Test
+	void trekDayHasParkingTrailAndHutWithUniqueCoordinates() {
+		GeneratedDayPlan day = stub.generate(request(List.of("HIKING", "MOUNTAINS"), 3)).get(1);
+		assertTrue(day.blocks().stream().anyMatch(block -> block.kind() == DayBlockKind.TREK));
+		List<GeneratedDayPlan.GeneratedDayPin> pins = day.blocks().stream()
+				.filter(block -> block.kind() == DayBlockKind.TREK)
+				.flatMap(block -> block.pins().stream())
+				.toList();
+		Set<DayPinRole> roles = new HashSet<>();
+		pins.forEach(pin -> roles.add(pin.role()));
+		assertTrue(roles.contains(DayPinRole.PARKING) || roles.contains(DayPinRole.TRAILHEAD));
+		assertTrue(roles.contains(DayPinRole.HUT) || roles.contains(DayPinRole.VIEWPOINT));
+		assertFalse(pins.stream().anyMatch(pin -> PinMapsUrlBuilder.isDestinationOnlyName(pin.name(), "Zakopane, Poland")));
+		assertTrue(DayPlanConcretenessValidator.validate(day, "Zakopane, Poland").isEmpty());
+		long uniqueCoords = pins.stream().map(pin -> pin.lat() + "," + pin.lng()).distinct().count();
+		assertEquals(pins.size(), uniqueCoords);
+	}
+
+	@Test
+	void neverEmitsMealInCity() {
+		for (GeneratedDayPlan day : stub.generate(request(List.of("FOOD", "CULTURE"), 2))) {
+			day.blocks().forEach(block -> {
+				assertFalse(DayPlanConcretenessValidator.looksGeneric(block.title(), "Lisbon, Portugal"));
+				assertFalse(block.title().toLowerCase().startsWith("meal in"));
+			});
+		}
+	}
+
+	private static DeepDayPlanRequest request(List<String> interests, int days) {
+		return new DeepDayPlanRequest(
+				new TripPlanGenerationRequest(
+						"Zakopane, Poland",
+						49.299,
+						19.949,
+						LocalDate.parse("2026-08-04"),
+						LocalDate.parse("2026-08-04").plusDays(days - 1L),
+						null,
+						interests,
+						List.of()),
+				ProposalType.INTENSE,
+				null);
+	}
+}
