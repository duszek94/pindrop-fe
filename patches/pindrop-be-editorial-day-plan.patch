@@ -0,0 +1,125 @@
+package com.duszek.pindrop.provider.ai.claude;
+
+import com.duszek.pindrop.config.AppProperties;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.reactive.function.client.WebClient;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+@Slf4j
+@Component
+public class AnthropicMessagesClient {
+
+	private final AppProperties appProperties;
+	private final JsonMapper jsonMapper;
+	private final WebClient webClient;
+
+	public AnthropicMessagesClient(AppProperties appProperties, JsonMapper jsonMapper) {
+		this.appProperties = appProperties;
+		this.jsonMapper = jsonMapper;
+		this.webClient = WebClient.builder()
+				.baseUrl("https://api.anthropic.com")
+				.build();
+	}
+
+	public boolean isConfigured() {
+		String key = apiKey();
+		return key != null && !key.isBlank();
+	}
+
+	public String complete(String system, String user, boolean webSearch) {
+		if (!isConfigured()) {
+			throw new IllegalStateException("Anthropic API key is not configured");
+		}
+
+		Map<String, Object> body = new LinkedHashMap<>();
+		body.put("model", model());
+		body.put("max_tokens", 16_000);
+		body.put("system", system);
+		body.put("messages", List.of(Map.of("role", "user", "content", user)));
+		if (webSearch) {
+			body.put("tools", List.of(Map.of("type", "web_search_20250305", "name", "web_search")));
+		}
+
+		@SuppressWarnings("unchecked")
+		Map<String, Object> response = webClient.post()
+				.uri("/v1/messages")
+				.contentType(MediaType.APPLICATION_JSON)
+				.header("x-api-key", apiKey())
+				.header("anthropic-version", "2023-06-01")
+				.bodyValue(body)
+				.retrieve()
+				.bodyToMono(Map.class)
+				.block();
+
+		if (response == null) {
+			throw new IllegalStateException("Empty Anthropic response");
+		}
+		return extractText(response);
+	}
+
+	@SuppressWarnings("unchecked")
+	private String extractText(Map<String, Object> response) {
+		Object content = response.get("content");
+		if (content instanceof String text) {
+			return text;
+		}
+		if (!(content instanceof List<?> blocks) || blocks.isEmpty()) {
+			throw new IllegalStateException("Anthropic response missing content");
+		}
+		List<String> texts = new ArrayList<>();
+		for (Object block : blocks) {
+			if (block instanceof Map<?, ?> map) {
+				Object type = map.get("type");
+				if ("text".equals(String.valueOf(type)) && map.get("text") != null) {
+					texts.add(String.valueOf(map.get("text")));
+				}
+			}
+		}
+		if (texts.isEmpty()) {
+			try {
+				JsonNode node = jsonMapper.valueToTree(response);
+				JsonNode contentNode = node.get("content");
+				if (contentNode != null && contentNode.isArray()) {
+					for (JsonNode item : contentNode) {
+						if ("text".equals(item.path("type").asString()) && item.get("text") != null) {
+							texts.add(item.get("text").asString());
+						}
+					}
+				}
+			} catch (Exception ex) {
+				log.debug("Failed to parse Anthropic content tree: {}", ex.getMessage());
+			}
+		}
+		if (texts.isEmpty()) {
+			throw new IllegalStateException("Anthropic response had no text blocks");
+		}
+		return String.join("\n", texts);
+	}
+
+	private String apiKey() {
+		String anthropic = appProperties.getAi().getAnthropicApiKey();
+		if (anthropic != null && !anthropic.isBlank()) {
+			return anthropic;
+		}
+		if ("claude".equalsIgnoreCase(appProperties.getAi().getProvider())) {
+			return appProperties.getAi().getApiKey();
+		}
+		return "";
+	}
+
+	private String model() {
+		String configured = appProperties.getAi().getAnthropicModel();
+		if (configured != null && !configured.isBlank()) {
+			return configured;
+		}
+		return "claude-sonnet-4-20250514";
+	}
+}
