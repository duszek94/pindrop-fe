+			List<GeneratedDayPlan> days,
+			String destination,
+			double tripLat,
+			double tripLng,
+			Set<String> alreadyUsedPlaceIds) {
+		Set<String> usedPlaceIds = new HashSet<>(alreadyUsedPlaceIds != null ? alreadyUsedPlaceIds : Set.of());
+		List<GeneratedDayPlan> enrichedDays = new ArrayList<>();
+		for (GeneratedDayPlan day : days) {
+			List<GeneratedDayPlan.GeneratedDayBlock> blocks = new ArrayList<>();
+			for (GeneratedDayPlan.GeneratedDayBlock block : day.blocks()) {
+				blocks.add(enrichBlock(block, destination, tripLat, tripLng, usedPlaceIds));
+			}
+			enrichedDays.add(day.withBlocks(blocks));
+		}
+		return uniquifyMapsUrls(enrichedDays, destination);
+	}
+
+	private GeneratedDayPlan.GeneratedDayBlock enrichBlock(
+			GeneratedDayPlan.GeneratedDayBlock block,
+			String destination,
+			double tripLat,
+			double tripLng,
+			Set<String> usedPlaceIds) {
+		List<GeneratedDayPlan.GeneratedDayPin> pins = new ArrayList<>();
+		PlaceSearchResult photoMatch = null;
+		List<GeneratedDayPlan.GeneratedDayPin> sourcePins = block.pins() != null ? block.pins() : List.of();
+		for (GeneratedDayPlan.GeneratedDayPin pin : sourcePins) {
+			if (PinMapsUrlBuilder.isDestinationOnlyName(pin.name(), destination)) {
+				continue;
+			}
+			GeneratedDayPlan.GeneratedDayPin enriched = enrichPin(pin, destination, tripLat, tripLng, usedPlaceIds);
+			pins.add(enriched);
+			if (photoMatch == null && enriched.placeId() != null && googlePlacesClient.isConfigured()) {
+				photoMatch = lookup(enriched.name(), destination, tripLat, tripLng);
+			}
+		}
+
+		List<GeneratedDayPlan.GeneratedDayBlock> alternatives = new ArrayList<>();
+		if (block.alternatives() != null) {
+			for (GeneratedDayPlan.GeneratedDayBlock alternative : block.alternatives()) {
+				alternatives.add(enrichBlock(alternative, destination, tripLat, tripLng, usedPlaceIds));
+			}
+		}
+
+		GeneratedDayPlan.GeneratedDayBlock next = block.withPins(pins).withAlternatives(alternatives);
+		if (photoMatch != null && photoMatch.photoUrl() != null && !photoMatch.photoUrl().isBlank()) {
+			return next.withPhoto(photoMatch.photoUrl(), PhotoConfidence.HIGH);
+		}
+		return next.withPhoto(null, PhotoConfidence.NONE);
+	}
+
+	private GeneratedDayPlan.GeneratedDayPin enrichPin(
+			GeneratedDayPlan.GeneratedDayPin pin,
+			String destination,
+			double tripLat,
+			double tripLng,
+			Set<String> usedPlaceIds) {
+		PlaceSearchResult match = lookup(pin.name(), destination, tripLat, tripLng);
+		if (match == null || !isStrongMatch(match, pin, destination, tripLat, tripLng)) {
+			return PinMapsUrlBuilder.withResolvedUrl(pin, destination);
+		}
+		if (match.placeId() != null && !usedPlaceIds.add(match.placeId())) {
+			return PinMapsUrlBuilder.withResolvedUrl(pin, destination);
+		}
+
+		GeneratedDayPlan.GeneratedDayPin updated = pin.enriched(
+				pin.name(),
+				pin.role(),
+				match.lat() != 0 ? match.lat() : pin.lat(),
+				match.lng() != 0 ? match.lng() : pin.lng(),
+				match.placeId(),
+				null,
+				firstNonBlank(match.displayName(), pin.address()),
+				pin.costLabel());
+		return PinMapsUrlBuilder.withResolvedUrl(updated, destination);
+	}
+
+	private PlaceSearchResult lookup(String name, String destination, double tripLat, double tripLng) {
+		if (!googlePlacesClient.isConfigured() || name == null || name.isBlank()) {
+			return null;
+		}
+		String query = name + ", " + destination;
+		List<PlaceSearchResult> results = googlePlacesClient.search(query, 3, tripLat, tripLng);
+		return results.isEmpty() ? null : results.get(0);
+	}
+
+	private boolean isStrongMatch(
+			PlaceSearchResult match,
+			GeneratedDayPlan.GeneratedDayPin pin,
+			String destination,
+			double tripLat,
+			double tripLng) {
+		if (match == null || match.name() == null) {
+			return false;
+		}
+		if (PinMapsUrlBuilder.isDestinationOnlyName(match.name(), destination)) {
+			return false;
+		}
+		double distanceKm = haversineKm(tripLat, tripLng, match.lat(), match.lng());
+		if (distanceKm > STRONG_MATCH_KM) {
+			return false;
+		}
+		String needle = PinMapsUrlBuilder.normalize(pin.name());
+		String haystack = PinMapsUrlBuilder.normalize(match.name() + " " + match.displayName());
+		return haystack.contains(firstToken(needle)) || needle.contains(PinMapsUrlBuilder.normalize(match.name()));
+	}
+
+	private static List<GeneratedDayPlan> uniquifyMapsUrls(List<GeneratedDayPlan> days, String destination) {
+		Set<String> seen = new HashSet<>();
+		List<GeneratedDayPlan> result = new ArrayList<>();
+		for (GeneratedDayPlan day : days) {
+			List<GeneratedDayPlan.GeneratedDayBlock> blocks = new ArrayList<>();
+			for (GeneratedDayPlan.GeneratedDayBlock block : day.blocks()) {
+				blocks.add(uniquifyBlock(block, destination, seen));
+			}
+			result.add(day.withBlocks(blocks));
+		}
+		return result;
+	}
+
+	private static GeneratedDayPlan.GeneratedDayBlock uniquifyBlock(
+			GeneratedDayPlan.GeneratedDayBlock block,
+			String destination,
+			Set<String> seen) {
+		List<GeneratedDayPlan.GeneratedDayPin> pins = new ArrayList<>();
+		List<GeneratedDayPlan.GeneratedDayPin> sourcePins = block.pins() != null ? block.pins() : List.of();
+		for (GeneratedDayPlan.GeneratedDayPin pin : sourcePins) {
+			GeneratedDayPlan.GeneratedDayPin resolved = PinMapsUrlBuilder.withResolvedUrl(pin, destination);
+			if (resolved.mapsUrl() != null && !seen.add(resolved.mapsUrl())) {
+				resolved = PinMapsUrlBuilder.withResolvedUrl(
+						new GeneratedDayPlan.GeneratedDayPin(
+								pin.name(), pin.role(), null, null, null, null, pin.address(), pin.costLabel()),
+						destination);
+				seen.add(resolved.mapsUrl());
+			}
+			pins.add(resolved);
+		}
+		List<GeneratedDayPlan.GeneratedDayBlock> alternatives = new ArrayList<>();
+		if (block.alternatives() != null) {
+			for (GeneratedDayPlan.GeneratedDayBlock alternative : block.alternatives()) {
+				alternatives.add(uniquifyBlock(alternative, destination, seen));
+			}
+		}
+		return block.withPins(pins).withAlternatives(alternatives);
+	}
+
+	private static String firstToken(String value) {
+		if (value == null || value.isBlank()) {
+			return "";
+		}
+		return value.split(" ")[0];
+	}
+
+	private static String firstNonBlank(String... values) {
+		for (String value : values) {
+			if (value != null && !value.isBlank()) {
+				return value;
+			}
+		}
+		return null;
+	}
+
+	static double haversineKm(double lat1, double lng1, double lat2, double lng2) {
+		double earth = 6371.0;
+		double dLat = Math.toRadians(lat2 - lat1);
+		double dLng = Math.toRadians(lng2 - lng1);
+		double a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
+				+ Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2))
+				* Math.sin(dLng / 2) * Math.sin(dLng / 2);
+		return earth * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
+	}
+
+	@SuppressWarnings("unused")
+	private static String locale(String value) {
+		return value == null ? "" : value.toLowerCase(Locale.ROOT);
+	}
+}
