@@ -0,0 +1,118 @@
+package com.duszek.pindrop.service;
+
+import com.duszek.pindrop.dto.planning.DayPlanResponse;
+import com.duszek.pindrop.dto.planning.ItineraryDaySummary;
+import com.duszek.pindrop.entity.ProposalType;
+import com.duszek.pindrop.entity.Trip;
+import com.duszek.pindrop.entity.TripDayPlan;
+import com.duszek.pindrop.exception.ResourceNotFoundException;
+import com.duszek.pindrop.provider.ai.TripPlanGenerationRequest;
+import com.duszek.pindrop.provider.dayplan.ClaudeFirstDayPlanProvider;
+import com.duszek.pindrop.provider.dayplan.DayPinEnricher;
+import com.duszek.pindrop.provider.dayplan.DeepDayPlanRequest;
+import com.duszek.pindrop.provider.dayplan.GeneratedDayPlan;
+import com.duszek.pindrop.provider.weather.WeatherForecast;
+import com.duszek.pindrop.provider.weather.WeatherProvider;
+import com.duszek.pindrop.repository.TripDayPlanRepository;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+@Service
+@RequiredArgsConstructor
+public class DayPlanService {
+
+	private final TripDayPlanRepository tripDayPlanRepository;
+	private final ClaudeFirstDayPlanProvider dayPlanAiProvider;
+	private final DayPinEnricher dayPinEnricher;
+	private final WeatherProvider weatherProvider;
+
+	@Transactional(readOnly = true)
+	public List<ItineraryDaySummary> listDays(Long tripId) {
+		return tripDayPlanRepository.findByTripIdOrderByDayNumberAsc(tripId).stream()
+				.map(plan -> new ItineraryDaySummary(
+						plan.getDayNumber(),
+						plan.getDayDate(),
+						plan.getDayRole() != null ? plan.getDayRole().name() : null,
+						plan.getActivityDomain(),
+						plan.getThemes() != null ? String.join(" · ", plan.getThemes()) : null,
+						plan.getNarrative(),
+						plan.getCostMin(),
+						plan.getCostMax(),
+						plan.getDurationLabel()))
+				.toList();
+	}
+
+	@Transactional(readOnly = true)
+	public DayPlanResponse getDay(Long tripId, int dayNumber) {
+		TripDayPlan plan = tripDayPlanRepository.findByTripIdAndDayNumber(tripId, dayNumber)
+				.orElseThrow(() -> new ResourceNotFoundException("Day plan not found"));
+		return DayPlanMapper.toResponse(plan);
+	}
+
+	@Transactional
+	public void persistDeepItinerary(Trip trip, ProposalType type) {
+		deleteAllDays(trip.getId());
+		List<GeneratedDayPlan> generated = generate(trip, type, null);
+		persist(trip, generated, Set.of());
+	}
+
+	@Transactional
+	public DayPlanResponse regenerateDay(Trip trip, int dayNumber) {
+		Set<String> used = new HashSet<>(tripDayPlanRepository.findUsedPlaceIds(trip.getId()));
+		tripDayPlanRepository.findByTripIdAndDayNumber(trip.getId(), dayNumber)
+				.ifPresent(plan -> {
+					plan.getBlocks().stream()
+							.flatMap(block -> block.getPins().stream())
+							.map(pin -> pin.getPlaceId())
+							.filter(id -> id != null && !id.isBlank())
+							.forEach(used::remove);
+					tripDayPlanRepository.delete(plan);
+				});
+		tripDayPlanRepository.flush();
+
+		List<GeneratedDayPlan> generated = generate(trip, trip.getSelectedProposalType(), dayNumber);
+		persist(trip, generated, used);
+		return getDay(trip.getId(), dayNumber);
+	}
+
+	private void deleteAllDays(Long tripId) {
+		List<TripDayPlan> existing = tripDayPlanRepository.findByTripIdOrderByDayNumberAsc(tripId);
+		tripDayPlanRepository.deleteAll(existing);
+		tripDayPlanRepository.flush();
+	}
+
+	private List<GeneratedDayPlan> generate(Trip trip, ProposalType type, Integer dayNumber) {
+		return dayPlanAiProvider.generateDayPlans(new DeepDayPlanRequest(buildContext(trip), type, dayNumber));
+	}
+
+	private void persist(Trip trip, List<GeneratedDayPlan> generated, Set<String> alreadyUsedPlaceIds) {
+		double lat = trip.getLat() != null ? trip.getLat() : 0;
+		double lng = trip.getLng() != null ? trip.getLng() : 0;
+		List<GeneratedDayPlan> enriched = dayPinEnricher.enrich(
+				generated, trip.getDestination(), lat, lng, alreadyUsedPlaceIds);
+		for (GeneratedDayPlan day : enriched) {
+			tripDayPlanRepository.save(DayPlanMapper.toEntity(trip, day));
+		}
+	}
+
+	private TripPlanGenerationRequest buildContext(Trip trip) {
+		double lat = trip.getLat() != null ? trip.getLat() : 0;
+		double lng = trip.getLng() != null ? trip.getLng() : 0;
+		List<WeatherForecast> weather = weatherProvider.getForecast(
+				lat, lng, trip.getStartDate(), trip.getEndDate());
+		return new TripPlanGenerationRequest(
+				trip.getDestination(),
+				lat,
+				lng,
+				trip.getStartDate(),
+				trip.getEndDate(),
+				trip.getPreferenceProfile(),
+				trip.getInterests() != null ? trip.getInterests() : List.of(),
+				weather);
+	}
+}
