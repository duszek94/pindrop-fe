+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayPinRole;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class PinMapsUrlBuilderTest {
+
+	@Test
+	void prefersPlaceId() {
+		String url = PinMapsUrlBuilder.build(
+				new GeneratedDayPlan.GeneratedDayPin("Lake Geneva", DayPinRole.STOP, 46.2, 6.1, "ChIJswiss", null, null, null),
+				"Lake Geneva, Vaud, Switzerland");
+		assertTrue(url.contains("query_place_id=ChIJswiss"));
+		assertFalse(url.contains("Lake+Geneva%2C+Lake+Geneva"));
+	}
+
+	@Test
+	void usesCoordinatesWhenPresent() {
+		String url = PinMapsUrlBuilder.build(
+				new GeneratedDayPlan.GeneratedDayPin("Lake Geneva", DayPinRole.STOP, 46.4414, 6.5295, null, null, null, null),
+				"Lake Geneva, Vaud, Switzerland");
+		assertTrue(url.contains("46.4414,6.5295"));
+	}
+
+	@Test
+	void neverBuildsDestinationCommaDestination() {
+		String url = PinMapsUrlBuilder.build(
+				new GeneratedDayPlan.GeneratedDayPin("Lake Geneva", DayPinRole.STOP, null, null, null, null, "Lake Geneva", null),
+				"Lake Geneva, Vaud, Switzerland");
+		assertTrue(url.contains("Switzerland"));
+		assertFalse(url.contains("Lake+Geneva%2C+Lake+Geneva"));
+	}
+
+	@Test
+	void detectsDestinationOnlyNames() {
+		assertTrue(PinMapsUrlBuilder.isDestinationOnlyName("Lake Geneva", "Lake Geneva, Vaud, Switzerland"));
+		assertFalse(PinMapsUrlBuilder.isDestinationOnlyName("Palenica Białczańska", "Zakopane, Poland"));
+	}
+}
