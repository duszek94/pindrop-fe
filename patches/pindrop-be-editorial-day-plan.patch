@@ -0,0 +1,87 @@
+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.dto.planning.PreferenceProfile;
+import com.duszek.pindrop.entity.ProposalType;
+import com.duszek.pindrop.provider.ai.TripPlanGenerationRequest;
+
+public final class EditorialDayPlanPromptBuilder {
+
+	private EditorialDayPlanPromptBuilder() {
+	}
+
+	public static String systemPrompt() {
+		return """
+				You are Pindrop's editorial travel planner. You write days the way a knowledgeable local guide would: \
+				narrative first, then timed chapters, then specific map pins. Use web search for real venue names, \
+				trailheads, huts, museums, beaches, and restaurants. Return JSON only.
+				""";
+	}
+
+	public static String buildDeepPrompt(DeepDayPlanRequest request) {
+		TripPlanGenerationRequest trip = request.trip();
+		PreferenceProfile profile = trip.preferenceProfile();
+		String city = PinMapsUrlBuilder.destinationCity(trip.destination());
+		ProposalType type = request.proposalType() != null ? request.proposalType() : ProposalType.BALANCED;
+		String dayFilter = request.dayNumber() != null
+				? "Generate ONLY dayNumber " + request.dayNumber() + "."
+				: "Generate every day from startDate to endDate inclusive.";
+
+		return """
+				Return JSON only with this shape:
+				{"days":[{"dayNumber":1,"date":"%s","title":"...","narrative":"2-3 sentences of context","themes":["..."],"dayRole":"ARRIVAL|EXPLORE|EXCURSION|RELAX|DEPARTURE","activityDomain":"MOUNTAIN_TRAIL|CITY_WALKING|MUSEUM_GALLERY|BEACH_LEISURE|FOOD_DINING","stats":{"distanceKm":11.0,"durationLabel":"8 h","elevationM":820,"costMin":40,"costMax":65,"currency":"EUR"},"blocks":[{"kind":"TREK|CITY_WALK|MUSEUM|BEACH|CAMP|FOOD|TRANSIT|EVENING|REST|ARRIVAL","startTime":"08:30","endTime":"17:00","flexibility":"FIXED|FLEXIBLE|WINDOW","title":"Concrete place or trail name","narrative":"What happens in this window","logistics":"tickets, parking, cash, reservation","costLabel":"€12–18","costMin":12,"costMax":18,"routeSummary":"Stop A → Stop B → Stop C","links":[{"type":"ALLTRAILS|YOUTUBE|ARTICLE|TICKETS|WIKILOC|MAPS|OTHER","url":"https://...","label":"..."}],"pins":[{"name":"Unique venue name","role":"PARKING|TRAILHEAD|VIEWPOINT|HUT|RESTAURANT|SHOP|BEACH|MUSEUM|CAMP|LODGING|STOP","lat":49.213,"lng":20.071,"address":"street if known","costLabel":null}],"alternatives":[{"kind":"TREK","startTime":"08:30","endTime":"13:00","title":"Shorter option to a named place","narrative":"...","pins":[],"links":[],"alternatives":[]}]}]}]}
+
+				HARD RULES:
+				- Never use the destination city (%s) as a pin name.
+				- Never write generic titles like "Meal in %s", "Check in and orient", "Local cuisine in %s".
+				- Every CORE block (TREK, CITY_WALK, MUSEUM, BEACH, CAMP, FOOD) needs unique pins with distinct lat/lng.
+				- Two pins in the same day must not share coordinates and must resolve to different maps queries.
+				- Prefer real researched names (trailheads, huts, museums, plazas, coves). Include coordinates.
+				- Photos are not your job; omit photoUrl.
+				- %s
+
+				PLAYBOOKS (pick kind per block; same JSON schema for all):
+				%s
+				%s
+				%s
+				%s
+				%s
+
+				Destination: %s (lat %s, lng %s)
+				Dates: %s to %s
+				Proposal variant: %s
+				Interests: %s
+				Preferences: pace=%s budget=%s transport=%s extra=%s
+				""".formatted(
+				trip.startDate(),
+				city,
+				city,
+				city,
+				dayFilter,
+				DayPlaybooks.TREK.promptHint(),
+				DayPlaybooks.CITY_WALK.promptHint(),
+				DayPlaybooks.MUSEUM.promptHint(),
+				DayPlaybooks.BEACH.promptHint(),
+				DayPlaybooks.CAMP.promptHint(),
+				trip.destination(),
+				trip.lat(),
+				trip.lng(),
+				trip.startDate(),
+				trip.endDate(),
+				type,
+				trip.interests(),
+				profile != null ? profile.getPace() : "BALANCED",
+				profile != null ? profile.getBudgetStyle() : "MID_RANGE",
+				profile != null ? profile.getTransportModes() : java.util.Set.of(),
+				profile != null && profile.getAdditionalRequirements() != null
+						? profile.getAdditionalRequirements()
+						: "none");
+	}
+
+	public static String retryPrompt(String previousErrors) {
+		return """
+				Your previous day plan was rejected. Fix EVERY issue and return JSON only. Do not use destination-named pins. \
+				Give each pin unique coordinates. Issues:
+				%s
+				""".formatted(previousErrors);
+	}
+}
diff --git a/src/main/java/com/duszek/pindrop/provider/dayplan/EditorialDayPlanStub.java b/src/main/java/com/duszek/pindrop/provider/dayplan/EditorialDayPlanStub.java
