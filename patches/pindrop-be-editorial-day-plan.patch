+package com.duszek.pindrop.provider.dayplan;
+
+import com.duszek.pindrop.entity.DayBlockKind;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+class DayPlanJsonParserTest {
+
+	@Test
+	void parsesEditorialDayJson() {
+		String json = """
+				{"days":[{"dayNumber":3,"date":"2026-08-06","title":"Rysy","narrative":"Wejście od Palenicy.","themes":["Rysy","Hut lunch"],"stats":{"distanceKm":14,"durationLabel":"8-9 h","elevationM":1100,"costMin":25,"costMax":40,"currency":"EUR"},"blocks":[{"kind":"TREK","startTime":"08:30","endTime":"17:00","title":"Szlak na Rysy","narrative":"Główna część.","pins":[{"name":"Wodogrzmoty Mickiewicza","role":"TRAILHEAD","lat":49.213,"lng":20.071},{"name":"Czarny Staw","role":"VIEWPOINT","lat":49.188,"lng":20.076}],"links":[{"type":"YOUTUBE","url":"https://youtu.be/x","label":"Film"}],"alternatives":[]}]}]}
+				""";
+		List<GeneratedDayPlan> days = DayPlanJsonParser.parseDays(new JsonMapper(), json);
+		assertEquals(1, days.size());
+		assertEquals(3, days.get(0).dayNumber());
+		assertEquals(DayBlockKind.TREK, days.get(0).blocks().get(0).kind());
+		assertEquals(2, days.get(0).blocks().get(0).pins().size());
+		assertFalse(PinMapsUrlBuilder.isDestinationOnlyName(
+				days.get(0).blocks().get(0).pins().get(0).name(), "Zakopane, Poland"));
+	}
+}
